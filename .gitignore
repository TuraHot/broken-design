!services/cdn-service/storage_data/.gitkeep
services/cdn-service/tmp_uploads/*
!services/cdn-service/tmp_uploads/.gitkeep

# Logs & OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

