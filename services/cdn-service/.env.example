# Server & Direct Database Connection
PORT=4001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/broken_design

# Auth & 3D Watermarking
JWT_SECRET=replace-with-strong-secret-key
WATERMARK_SECRET=replace-with-strong-watermark-secret

# Storage Config (local | supabase)
STORAGE_PROVIDER=supabase
STORAGE_DIR=./storage_data
TMP_UPLOAD_DIR=./tmp_uploads
MAX_CACHE_BYTES=1073741824
TMP_CLEANUP_MAX_AGE_MS=3600000

# Frontend Origin for Scoped API CORS (/api/* and /verify-watermark)
FRONTEND_URL=http://localhost:3000

# Supabase Storage (ใช้สำหรับเก็บไฟล์ .glb ใน Bucket "models" แบบ private เมื่อ STORAGE_PROVIDER=supabase)
# Production: ใช้ sb_secret_... หรือ service_role JWT เพื่อให้ cdn-service ปิด RLS policy ของ anon ให้อัตโนมัติ
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_STORAGE_BUCKET=models
SUPABASE_AVATAR_BUCKET=profile_logo

# Upload File Size Limits (Bytes)
MAX_MODEL_SIZE_BYTES=52428800
MAX_PREVIEW_SIZE_BYTES=5242880
MAX_POSTER_SIZE_BYTES=1048576

# CDN (/cdn) & Rate Limit (Optional — มีค่าเริ่มต้นในโค้ดอยู่แล้ว; ตั้ง TRUST_PROXY=1 บน Render)
TRUST_PROXY=0
CDN_PUBLIC_MAX_AGE=300
CDN_RATE_LIMIT_PER_MIN=600
CDN_KEY_FAILURES_PER_15MIN=30
CDN_DOWNLOADS_PER_MIN=30
