# Server & Direct Database Connection
PORT=4000
NODE_ENV=development
# Local dev or Supabase IPv4 Session Pooler (required on Windows Docker Desktop)
DATABASE_URL=postgresql://postgres:password@localhost:5432/broken_design
# Max PostgreSQL connections this process keeps open (default 3). The Supabase session pooler (:5432) allows
# only 15 clients for the whole project, shared by every teammate and both services.
# Supavisor transaction mode (:6543) allows far more clients and works with node-postgres (no named prepared statements).
DB_POOL_MAX=3

# Reverse Proxy (set TRUST_PROXY=1 on Render / Nginx / Cloudflare so rate limits read real client IP)
TRUST_PROXY=0

# Auth & Connected Services
JWT_SECRET=replace-with-strong-secret-key
FRONTEND_URL=http://localhost:3000
CDN_SERVICE_URL=http://localhost:4001

# Payment Mode
PAYMENT_PROVIDER=mock
PLATFORM_FEE_BPS=700

# ยังไม่ได้ใช้ในปัจจุบัน (ใช้เมื่อเปลี่ยน PAYMENT_PROVIDER=stripe ในอนาคต)
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
