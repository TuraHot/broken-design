# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
services/core-api/.env
services/cdn-service/.env
frontend/.env

# Build outputs
dist/
build/
.next/
out/

# Local Disk Storage & Temp Uploads (Managed by cdn-service)
